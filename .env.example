# Base URL for the real Truepas REST API (used when EXPO_PUBLIC_USE_MOCK_API=false)
EXPO_PUBLIC_API_URL=https://api.truepas.example

# Set to "false" once the backend endpoints in src/api/endpoints.ts are ready.
# When "true" (default), the app serves data from the JSON fixtures in
# src/api/data/ via src/api/mock.ts — no backend needed for UI development.
EXPO_PUBLIC_USE_MOCK_API=true
