# ── Truepas Backend URLs ──────────────────────────────────────────────

# customer-app-bff — BFF gateway for the React Native app (auth, user,
# family, documents, bookings, profile, security).
EXPO_PUBLIC_API_URL=https://api.dev.truepas.com/cb

# liveness-service — face enrollment, face verification, face update,
# liveness check. Separate service with its own base URL.
EXPO_PUBLIC_LIVENESS_URL=https://api.dev.truepas.com/ls

# ── API Mode ──────────────────────────────────────────────────────────

# "false" → use real REST API (src/api/endpoints.ts)
# "true"  → use JSON mock fixtures (src/api/mock.ts) — no backend needed
EXPO_PUBLIC_USE_MOCK_API=true

# ── Fallback ──────────────────────────────────────────────────────────

# When "true", if the real API returns 503 or a network error, the app
# falls back to mock data so UI development can continue. Set to "false"
# for strict real-only mode (errors surface to the user).
EXPO_PUBLIC_FALLBACK_TO_MOCK=true
